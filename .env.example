# Copia este archivo a .env.local y llena los valores (Supabase → Project Settings → API).
# Solo van aquí claves PÚBLICAS: la service_role nunca se pone en el frontend ni en el repo.

VITE_SUPABASE_URL=https://<id-del-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<clave-anon-publica>

# --- Solo del servidor (función api/publicar.ts). NUNCA con prefijo VITE_. ---
# En Vercel: Settings → Environment Variables (Production), no en .env.local del equipo.
# Deploy hook de producción (Vercel → Settings → Git → Deploy Hooks, rama main). Es un secreto.
# VERCEL_DEPLOY_HOOK_URL=
# Solo en `npm run dev`: "despliega" escribiendo public/respaldo/publicacion.json.
# DESPLIEGUE_LOCAL=1
